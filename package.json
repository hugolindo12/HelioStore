{
  "name": "helio-store",
  "productName": "Helio Store",
  "version": "2.0.1",
  "description": "Helio Store — a loja para instalar os seus aplicativos.",
  "main": "main.js",
  "author": "Helio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --publish never",
    "i18n": "node scripts/i18n-check.js"
  },
  "build": {
    "appId": "com.helio.store",
    "productName": "Helio Store",
    "files": [
      "main.js",
      "preload.js",
      "github.js",
      "src/**/*",
      "catalog/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "artifactName": "HelioStore-Setup-${version}.exe",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "es_ES"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hugolindo12/HelioStore.git"
  },
  "homepage": "https://github.com/hugolindo12/HelioStore#readme",
  "bugs": {
    "url": "https://github.com/hugolindo12/HelioStore/issues"
  },
  "keywords": [
    "electron",
    "app-store",
    "windows",
    "github-releases"
  ]
}
